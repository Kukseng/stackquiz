{
  "redirects": [
    {
      "source": "https://www.stackquiz-two.vercel.app/:path*",
      "destination": "https://stackquiz-two.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/:path*(svg|png|jpg|jpeg|gif|webp|ico|woff|woff2|ttf|otf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Expires", "value": "Wed, 21 Oct 2026 07:28:00 GMT" }
      ]
    }
  ]
}
